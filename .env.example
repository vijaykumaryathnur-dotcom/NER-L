# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration
# VITE_SUPABASE_URL: Your Supabase Project URL (e.g. https://xyz.supabase.co)
VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY: Your Supabase Anonymous/Public API Key
VITE_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY: Optional server-only service role key for Edge/API telemetry verification
SUPABASE_SERVICE_ROLE_KEY=""

# Routing & Geocoding
# OPENROUTE_SERVICE_API_KEY: Optional API key for OpenRouteService (server proxies requests; defaults to real OSRM road routing if unset)
OPENROUTE_SERVICE_API_KEY=""

# Traffic Incidents
# TOMTOM_API_KEY: TomTom developer API key for real-time traffic incidents in the North East corridor
TOMTOM_API_KEY=""
